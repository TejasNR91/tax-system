# ==========================================
# TaxSaathi AI — Environment Configuration
# ==========================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gmail SMTP Configuration for Real OTP Delivery
# How to set up Gmail App Password:
# 1. Go to Google Account -> Security -> Enable "2-Step Verification"
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App name (e.g., "TaxSaathi"), click Create.
# 4. Copy the generated 16-character password (e.g. "abcd efgh ijkl mnop")
# 5. Paste it in EMAIL_PASSWORD below without spaces.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=TaxSaathi AI <no-reply@taxsaathi.in>
EMAIL_USE_TLS=True

# OTP Policies
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
